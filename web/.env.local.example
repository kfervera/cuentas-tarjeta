# Copiar este archivo a `.env.local` y completar con valores reales.
# `.env.local` NUNCA debe commitearse (ver .gitignore).

# --- Supabase (mismo proyecto que usa el skill gastos-kei-kev) ---
# URL y anon key del proyecto, desde Supabase Dashboard > Project Settings > API.
# El anon key es público por diseño (se usa desde el navegador) y queda acotado
# por las políticas RLS — ver pdf-parser/database-setup.md y plan-web.md §1.
# El service_role key NUNCA debe usarse ni definirse aquí.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Basic Auth (portón compartido, ver plan-web.md D6) ---
# Variables server-side únicamente (usadas en middleware.ts). Nunca deben
# llevar el prefijo NEXT_PUBLIC_ ni exponerse al cliente.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
